# ---------------------------------------------------------------------------
# Walkie Talkie — environment
# Copy to .env.local for development. NEVER commit a filled-in copy.
# Anything not prefixed NEXT_PUBLIC_ stays server-side only.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: bypasses Row Level Security. Server-only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- LiveKit (cloud.livekit.io -> Settings -> Keys) ---
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin bootstrap ---
# Comma-separated emails granted the admin role on first sign-in.
# Used only by the bootstrap migration; change the role in the DB afterwards.
ADMIN_BOOTSTRAP_EMAILS=you@example.com
